{
  "random_state": 42,
  "features": [
    "duration_ms",
    "invocation_count",
    "api_call_count",
    "access_denied_count",
    "error_count",
    "unexpected_target",
    "suspicious_input"
  ],
  "labels": [
    "normal",
    "event_injection",
    "privilege_abuse"
  ],
  "split": {
    "train": 800,
    "test": 200,
    "stratified": true
  },
  "logistic_regression": {
    "max_iter": 1000,
    "C": 1.0,
    "scaler": "StandardScaler"
  },
  "decision_tree": {
    "max_depth": 5,
    "min_samples_leaf": 5
  },
  "default_model_run": "training_run_001"
}
